# Django Secret Key (generate a secure random 50+ character string in production)
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-secret-key-for-production

# Debug Mode (set to False in production)
DEBUG=True

# Allow demonstration error routes (/debug/error/<code>/)
DEBUG_ROUTES=True

# Allowed Hosts (comma-separated list of hostnames or domains)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example Render: postgresql://planuser:secret@dpg-xxxx.render.com/planmystudy
DATABASE_URL=sqlite:///db.sqlite3

# MongoDB Atlas URI (used for chat logs and feedback)
# Format: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=planmystudy_db

# Anthropic Claude API Key (server-side only)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
